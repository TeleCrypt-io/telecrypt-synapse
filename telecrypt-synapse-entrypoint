#!/usr/local/bin/python
"""Prepare Synapse's disposable local media directories and start Synapse."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path
from typing import NoReturn


STAGING_PATH = "/staging"


def fail(message: str) -> NoReturn:
    print(f"telecrypt-synapse-entrypoint: {message}", file=sys.stderr)
    raise SystemExit(78)


def clear_directory(path: Path) -> None:
    if path.is_symlink():
        path.unlink()
    path.mkdir(parents=True, exist_ok=True)
    for child in path.iterdir():
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child)
        else:
            child.unlink()


def prepare_staging(staging: str = STAGING_PATH) -> None:
    root = Path(staging)
    temporary = root / "tmp"
    media = root / "media"
    try:
        clear_directory(temporary)
        clear_directory(media)
    except OSError:
        fail("staging directories could not be prepared")
    os.environ["TMPDIR"] = str(temporary)


def main(arguments: list[str]) -> None:
    prepare_staging()
    if not arguments:
        fail("Synapse command arguments are missing")
    command = [sys.executable, "-m", "synapse.app.homeserver", *arguments]
    try:
        os.execv(sys.executable, command)
    except OSError:
        fail("Synapse could not be executed")


if __name__ == "__main__":
    main(sys.argv[1:])
